# The autonomous pilot as a user service. Not enabled by default: start it when the game is
# ready, e.g.  systemctl --user start game-pilot.service
# Settings come from the repo's .env (GEMINI_API_KEY, PILOT_GAME, PILOT_SPEED, PILOT_DECIDE_MONTHS,
# PILOT_MODEL, …; see README → "Pilot app"). Stopping it pauses the game; a step that is still
# running 20 s after the stop (a slow model call; the game is already paused then) is abandoned.
[Unit]
Description=Game Pilot (autonomous LLM player)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/codeman-cases/game-harness
Environment=PYDANTIC_AI_NO_BANNER=1
ExecStart=/mnt/codeman-cases/game-harness/.venv/bin/python -m pilot run
KillSignal=SIGTERM
# SIGTERM to the pilot only: it still needs its controller subprocess to pause the game on exit
KillMode=mixed
TimeoutStopSec=60
Restart=no

[Install]
WantedBy=default.target
