# Game Pilot settings for a container install: copy to .env and fill in the three required values.
# A line starting with "# NAME=" is an optional setting left at its default; remove the "# " to set it.
# An empty value is read as set-but-empty, so leave unused optional settings commented out.
# The compose file's own variables (GAME_PILOT_VERSION, GAME_PILOT_PORT, GAME_PILOT_DATA) are read by
# compose from the shell or a .env next to compose.yaml; they are not passed into the container.

# ---- Required ----
# The dashboard starts without these (sign-in and history work); Start run is refused, naming each one that is missing.

# Model key for the default Google models (GOOGLE_API_KEY works too).
GEMINI_API_KEY=
# The Windows PC's game agent, e.g. http://192.168.1.77:8765.
GAME_AGENT_URL=
# The agent's bearer token (the agent's installer prints it; at least 32 characters).
GAME_AGENT_TOKEN=

# ---- Common ----

# The PC's screen size when it is not 3840x2160, e.g. 2560x1440.
# GAME_RESOLUTION=
# The address people open the dashboard at: http://<this machine's LAN address>:8780, or the https name
# behind a proxy. Set it in a container install: the sign-in link (pilot dashboard-link) is built from it,
# and without it holds the container's own address, which no other machine can reach. Page loads on other
# host names are redirected to it.
# PILOT_PUBLIC_URL=
# Comma list of the reverse proxy's addresses; with the secret below, its Remote-User is the signed-in user.
# PILOT_TRUSTED_PROXIES=
# The secret the reverse proxy sends in X-Pilot-Proxy.
# PILOT_PROXY_SECRET=
# The dashboard's service key for scripts (default: generated once into /data/secrets/dashboard.key).
# PILOT_DASHBOARD_KEY=
# Resume a run that was live when the container stopped, 10 s after the dashboard starts (default 1; 0, false, no or off turns it off).
# PILOT_RESUME=1
# An ntfy topic's full URL: a notice is posted when a run has needed you for 5 min, 30 min and 2 h (default off).
# PILOT_NOTIFY_URL=

# ---- Optional ----

# Other model providers' keys.
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Litestream: set the replica URL to back up pilot.db continuously (default off). On an empty data
# folder the container restores from the replica first. Credentials are for an S3-compatible store.
# LITESTREAM_REPLICA_URL=
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# Extra host names the dashboard answers to (comma list), besides PILOT_PUBLIC_URL's.
# PILOT_DASHBOARD_HOSTS=
# Sign-in store (default /data/auth.sqlite).
# PILOT_AUTH_DB=
# "cli" limits adding devices to the dashboard-link command (default: any signed-in device may add one).
# PILOT_ADD_DEVICE=
# 1 turns the recovery-key sign-in form on (default 0, off).
# PILOT_KEY_SIGNIN=0
# When set, a run's learned files and journals are exported there when it ends (default unset).
# PILOT_EXPORT_DIR=
# Frames kept per run (default 200).
# PILOT_FRAMES_KEEP=200

# Default model (default google:gemini-3.8-flash) and extra models offered in the dashboard (comma list).
# PILOT_MODEL=google:gemini-3.8-flash
# PILOT_MODELS=
# Model tried once when the main one stays overloaded (default google:gemini-3.1-pro-preview; none or off for no fallback).
# PILOT_FALLBACK_MODEL=google:gemini-3.1-pro-preview
# Thinking level for Galactic Civilizations IV episodes and for the governors' decisions (default medium).
# PILOT_THINKING=medium
# PILOT_GOVERNOR_THINKING=medium
# Screenshot coordinate space: auto, pixels or norm1000 (default auto, chosen from the model's provider).
# PILOT_COORDS=auto
# Image resolution sent to the model: low, medium or high (default medium).
# PILOT_IMAGE_DETAIL=medium
# The model guard: pacing, retries and failover (default 1; 0 runs the older whole-run retries).
# PILOT_MODEL_GUARD=1
# JSON objects: provider to seconds between requests (default {"google": 0.5}; setting it replaces the
# whole map, it does not merge into the default); model to {"rpm","tpm","daily_requests"}; model to family.
# PILOT_MIN_CALL_INTERVAL={"google": 0.5}
# PILOT_MODEL_LIMITS=
# PILOT_MODEL_FAMILIES=
# Seconds a request waits in all for its role's models to come back when every one is down (default 120; 0 gives up at once).
# PILOT_POOL_WAIT_S=120

# Game to play: galciv4, stellaris or civ6 (default galciv4; the dashboard's Start run sets it per run).
# PILOT_GAME=galciv4
# Stellaris game speed (default normal).
# PILOT_SPEED=normal
# Stellaris: months between decisions (default 12).
# PILOT_DECIDE_MONTHS=12
# Seconds between autosave polls (default 2).
# PILOT_POLL_S=2
# Stellaris: a strategy review after every N decisions (default 5; 0 never).
# PILOT_RETRO_EVERY=5
# Stellaris: the war crisis overlay (default 1; 0 turns it off).
# PILOT_WAR_CRISIS=1
# Galactic Civilizations IV: turns per autopilot call (default 20).
# PILOT_TURNS=20
# Civilization VI: turns the game's AI plays between decisions (default 5) and per autoplay call (default 3).
# PILOT_DECIDE_TURNS=5
# PILOT_AUTOPLAY_CHUNK=3
# Civilization VI: scripted last stand for a city about to fall (default 0, off) and the most stands in a row per city (default 3).
# PILOT_LAST_STAND=0
# PILOT_LAST_STAND_MAX=3
# Campaign name for telemetry (default: from the save).
# PILOT_CAMPAIGN=
# The live pilot's own dashboard port (default 8790) and bind address (default 127.0.0.1, inside the container).
# PILOT_PORT=8790
# PILOT_LIVE_HOST=127.0.0.1
# The dashboard's bind address (default 0.0.0.0).
# PILOT_VIEW_HOST=0.0.0.0

# ---- Set by the image (do not set) ----
# PILOT_DATA_DIR=/data
# the older alias of PILOT_DATA_DIR (which wins when both are set)
# PILOT_RUNS_DIR=/data
# PILOT_CORPORA_DIR=/app/corpora
# PILOT_CONTROLLER_BIN=/app/bin/game-controller
